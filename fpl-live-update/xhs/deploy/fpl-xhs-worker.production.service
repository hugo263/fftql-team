[Unit]
Description=TQL private Xiaohongshu scheduling worker (manual only)
After=local-fs.target

[Service]
Type=simple
# Reuses the main application's existing identity, with a separate filesystem
# and no capabilities/network. The host config, credentials and other apps
# are outside this root. No new user or access grants are installed.
User=root
RootDirectory=/var/lib/fpl-xhs-runtime
MountAPIVFS=yes
BindReadOnlyPaths=/opt/node-v24.18.1-linux-x64/bin/node:/usr/local/bin/node
BindReadOnlyPaths=/usr/lib64:/lib64
BindReadOnlyPaths=/opt/fpl-weekly/xhs:/app
BindPaths=/var/lib/fpl-xhs:/data
WorkingDirectory=/app
ExecStart=/usr/local/bin/node /app/worker.cjs
Environment=XHS_ENABLED=1 XHS_ALLOW_MOCK=0 XHS_DATA_DIR=/data NODE_ENV=production
Restart=on-failure
RestartSec=10
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
