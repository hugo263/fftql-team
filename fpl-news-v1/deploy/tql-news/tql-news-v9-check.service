[Unit]
Description=TQL news v9 isolated web validation
Requires=tql-news-v9-check.socket
After=tql-news-v9-check.socket
[Service]
Type=simple
DynamicUser=yes
User=tql-news
WorkingDirectory=/opt/tql-news/releases/20261002-v9-light-mobile
EnvironmentFile=/etc/tql-news/web.env
ExecStart=/usr/local/bin/node apps/web/server.ts
Restart=on-failure
RestartSec=1
TimeoutStopSec=70
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=384M
