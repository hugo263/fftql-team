[Unit]
Description=TQL FPL news collector and editorial worker
After=network-online.target tql-news-api.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
User=tql-news
WorkingDirectory=/opt/tql-news/current
EnvironmentFile=/etc/tql-news/app.env
ExecStart=/usr/local/bin/node apps/worker/src/main.ts
Restart=on-failure
RestartSec=15
# 已发送的模型请求允许完成并保存回执，避免重启重复付费。
TimeoutStopSec=210
StateDirectory=tql-news
StateDirectoryMode=0700
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=640M

[Install]
WantedBy=multi-user.target
