[Unit]
Description=TQL FPL news web
After=network-online.target tql-news-api.service tql-news-web.socket
Wants=network-online.target tql-news-api.service
Requires=tql-news-web.socket

[Service]
Type=simple
DynamicUser=yes
User=tql-news
WorkingDirectory=/opt/tql-news/current
EnvironmentFile=/etc/tql-news/web.env
ExecStart=/usr/local/bin/node apps/web/server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=210
StateDirectory=tql-news
StateDirectoryMode=0700
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=384M

[Install]
WantedBy=multi-user.target
