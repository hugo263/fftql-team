NODE_ENV=production
AIHOT_ENVIRONMENT=production
SITE_URL=https://news.fftql.team
API_PORT=9011
API_HOST=127.0.0.1
API_BASE_URL=http://127.0.0.1:9011
WEB_PORT=9012
WEB_HOST=127.0.0.1
TRUST_PROXY=true
DATABASE_POOL_MAX=5
# 使用现有服务器上独立的 tql_news 数据库，仅通过 loopback 连接。
DATABASE_URL=
AIHOT_DATA_DIR=/var/lib/tql-news
AIHOT_RELEASE=tql-news-v1
# 在目标服务器生成；此文件不得进入版本库。
ADMIN_PASSWORD=
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.5-flash
LLM_EXTRA_JSON='{"enable_thinking":false}'
LLM_VISION=false
# 迁移、种子、接口与网页检查通过后再开启 worker 采集和模型。
COLLECT_ENABLED=false
# Dedicated X SOCKS5 proxy; only X API calls use this, keeping RSS/images off its free quota.
X_EGRESS_PROXY_URL=
MODEL_CALLS_ENABLED=false
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
JINA_BODY_FALLBACK=false
